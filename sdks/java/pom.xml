<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.objectfs</groupId>
    <artifactId>objectfs-sdk</artifactId>
    <version>0.8.0</version>
    <packaging>jar</packaging>

    <name>ObjectFS Java SDK</name>
    <description>Java SDK for ObjectFS — enterprise-grade POSIX-compliant FUSE filesystem for AWS S3</description>
    <url>https://github.com/scttfrdmn/objectfs</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <!-- See the compiler-plugin configuration below for why this is `release`. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <jackson.version>2.22.2</jackson.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.version>4.13.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <okhttp.version>5.5.0</okhttp.version>
    </properties>

    <dependencies>
        <!-- JSON serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
          jackson-datatype-jsr310, for the JavaTimeModule that ObjectFSClient's constructor
          registers. ObjectFSClient.java imported it and this file did not declare it, so
          `mvn compile` failed with "package com.fasterxml.jackson.datatype.jsr310 does not exist"
          and this SDK has never built. Nothing in CI runs Maven, which is why: same structural gap
          as the JavaScript SDK, where 48 tsc errors survived because no job invoked the compiler.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Logging facade -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- HTTP client.
             `okhttp-jvm`, not `okhttp`. OkHttp 5 went multiplatform and split the artifact: as of
             5.4.0 `com.squareup.okhttp3:okhttp` is a stub containing zero .class files (verify with
             `unzip -l okhttp-5.4.0.jar | grep -c '\.class'`), and the JVM classes live in
             `okhttp-jvm`. Depending on the old coordinates compiles nothing and fails src/main with
             "package okhttp3 does not exist" — which reads like a sweeping API break rather than a
             renamed artifact. src/test would have passed either way, because mockwebserver below
             pulls okhttp-jvm in transitively at test scope.

             This is why #291 could never be merged as opened: Dependabot bumps versions, and this
             release moved the coordinates, so the version bump and this artifactId belong in the
             same commit or neither is correct. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <!--
                      `release`, not `source`+`target`. javac warned about the pair on every build:
                      "location of system modules is not set in conjunction with -source 17 ... may
                      lead to class files that cannot run on JDK 17". Compiling on a JDK 26 with
                      -source/-target 17 accepts calls to APIs that did not exist in 17, producing a
                      jar that compiles clean and throws NoSuchMethodError on the version it claims
                      to target. The `release` flag pins the platform API too. (Written as `release`
                      rather than with its two leading dashes because those would end this comment.)
                    -->
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
        </plugins>
    </build>
</project>
